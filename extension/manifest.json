{
  "manifest_version": 3,
  "name": "Tumblr Tag Helper",
  "version": "0.13.0",
  "description": "Browser companion of Tumblr Studio: tag suggestions and template insertion on tumblr.com, mass editor upgrades, hiding ads and recommendations, and shortcuts into the app.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.tumblr.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Tumblr Tag Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tumblr.com/*"
      ],
      "js": [
        "core.js",
        "noads.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tumblr.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tumblr.com/mega-editor/*"
      ],
      "js": [
        "mega-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://127.0.0.1:47823/companion/*",
        "http://127.0.0.1:47824/companion/*",
        "http://127.0.0.1:47825/companion/*"
      ],
      "js": [
        "companion-ops.js",
        "companion-host.js"
      ],
      "run_at": "document_end"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules_ads.json"
      }
    ]
  }
}
